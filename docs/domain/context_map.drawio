<mxfile host="app.diagrams.net">
  <diagram name="DDD-Context-Map" id="ddd-context-map-notion">
    <mxGraphModel dx="1422" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="hdr-box" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot; color=&quot;#ffffff&quot;&gt;DDD Context Map: Notion-Clone Platform&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cbd5e1&quot;&gt;Bounded Contexts &amp;amp; Integration Relationships (Core, Supporting, Generic Subdomains)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;align=left;spacingLeft=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="70" as="geometry" />
        </mxCell>

        <!-- 1. IAM Context -->
        <mxCell id="iam-ctx" value="&lt;b&gt;Identity &amp;amp; Access Management (IAM)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[GENERIC SUBDOMAIN | UPSTREAM (U)]&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Aggregate Root:&lt;/b&gt; Workspace&lt;br&gt;&lt;b&gt;Entities:&lt;/b&gt; User, WorkspaceMember&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Автентифікація (JWT)&lt;br&gt;• Модель доступу RBAC&lt;br&gt;• Організація просторів команд&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="380" height="260" as="geometry" />
        </mxCell>

        <!-- 2. Core Domain: Document & Page Management -->
        <mxCell id="core-ctx" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot; color=&quot;#312e81&quot;&gt;Document &amp;amp; Page Management&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#854d0e&quot;&gt;[CORE DOMAIN | AGGREGATE ROOT / COORDINATOR]&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Aggregate Root:&lt;/b&gt; Page&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; PageId, PageMetadata, Position&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Ієрархічне дерево сторінок (parent_id, depth)&lt;br&gt;• Життєвий цикл: створення, переміщення, архівація&lt;br&gt;• Валідація інваріантів (захист від циклів у дереві)&lt;br&gt;• Координація контентних блоків та таблиць&lt;br&gt;• Сайдбар-навігація та налаштування сторінки&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=3;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="480" height="300" as="geometry" />
        </mxCell>

        <!-- 3. Assets & Storage -->
        <mxCell id="assets-ctx" value="&lt;b&gt;Assets &amp;amp; Media Storage&lt;/b&gt;&lt;br&gt;&lt;i&gt;[GENERIC SUBDOMAIN]&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Entity:&lt;/b&gt; Attachment&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Зберігання файлів та медіа&lt;br&gt;• Валідація MIME та розміру&lt;br&gt;• Обкладинки сторінок, аватари&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="140" width="320" height="240" as="geometry" />
        </mxCell>

        <!-- 4. Block Engine -->
        <mxCell id="block-ctx" value="&lt;b&gt;Block Engine (Content Editor)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SUPPORTING SUBDOMAIN | DOWNSTREAM (D)]&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Entity:&lt;/b&gt; Block&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; BlockType, FormattingProperties&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Атомарний блоковий контент сторінки&lt;br&gt;• Поліморфізм: paragraph, heading, todo, code, quote&lt;br&gt;• Зміна порядку, вкладеність, стан todo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#14b8a6;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="540" width="440" height="260" as="geometry" />
        </mxCell>

        <!-- 5. Structured Data -->
        <mxCell id="table-ctx" value="&lt;b&gt;Structured Data (Inline Databases)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SUPPORTING SUBDOMAIN | DOWNSTREAM (D)]&lt;/i&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Aggregate Root:&lt;/b&gt; DataTable&lt;br&gt;&lt;b&gt;Entities / VOs:&lt;/b&gt; TableRow, Column&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Налаштовувана схема стовпців (типи, опції)&lt;br&gt;• Рядки записів з валідацією комірок&lt;br&gt;• Внутрішній облік техніки, регламентів&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#f43f5e;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="540" width="460" height="260" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="edge-iam-core" edge="1" source="iam-ctx" target="core-ctx" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#475569;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-iam-core" value="U [OHS/PL]&lt;br&gt;──► D [C/S]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="edge-iam-core">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-assets-core" edge="1" source="assets-ctx" target="core-ctx" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#475569;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-assets-core" value="U [S]&lt;br&gt;──► D [C]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="edge-assets-core">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-core-block" edge="1" source="core-ctx" target="block-ctx" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#6366f1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-core-block" value="U (Page Container)&lt;br&gt;──► D [PL: Block DTO]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="edge-core-block">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-core-table" edge="1" source="core-ctx" target="table-ctx" parent="1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#6366f1;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-core-table" value="U (Page Container)&lt;br&gt;──► D [Embedded DB]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="edge-core-table">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
